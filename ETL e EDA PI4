column\": \"G\\u00caNERO DA M\\u00daSICA\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 4,\n        \"samples\": [\n          \"Piseiro, Forr\\u00f3\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"MISOGINIA\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": null,\n        \"min\": null,\n        \"max\": null,\n        \"num_unique_values\": 0,\n        \"samples\": [],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"ANO\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0,\n        \"min\": 2021,\n        \"max\": 2021,\n        \"num_unique_values\": 1,\n        \"samples\": [],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}}],"source":["import pandas as pd\n","import os\n","import numpy as np\n","\n","# URL base do Google Sheet para exportar como XLSX\n","google_sheet_base_url = \"https://docs.google.com/spreadsheets/d/1seLizlB6tq5aTaIZxX5B38I99y_vGjNqpLOAGPuKrZg/export?format=xlsx\"\n","\n","# Anos (abas) que o usuário deseja ler\n","years_to_read = [2021, 2022, 2023, 2024, 2025]\n","dfs_from_sheets = []\n","canonical_columns = None\n","\n","try:\n","    # Passo 1: Ler a primeira aba para determinar os nomes das colunas canônicas\n","    first_sheet_name = str(years_to_read[0])\n","    # Ler apenas a linha do cabeçalho (header=0, nrows=0) para obter os nomes das colunas da aba '2021'\n","    # sheet_name=None para a primeira verificação, depois aba específica para inferência do cabeçalho\n","    all_sheet_names = pd.read_excel(google_sheet_base_url, sheet_name=None, header=None).keys()\n","    if first_sheet_name in all_sheet_names:\n","        first_sheet_header_df = pd.read_excel(google_sheet_base_url, sheet_name=first_sheet_name, header=0, nrows=0)\n","        # Remover colunas 'Unnamed' da lista canônica\n","        canonical_columns = [col for col in first_sheet_header_df.columns if not col.startswith('Unnamed:')]\n","    else:\n","        raise ValueError(f\"Aba '{first_sheet_name}' não encontrada para inferir colunas canônicas.\")\n","\n","    # Passo 2 e 3: Iterar por todas as abas, ler os dados, limpar e concatenar\n","    for year in years_to_read:\n","        sheet_name = str(year)\n","        if sheet_name in all_sheet_names:\n","            # Ler a aba atual, usando sua primeira linha como possível cabeçalho\n","            current_sheet_raw_df = pd.read_excel(google_sheet_base_url, sheet_name=sheet_name, header=0)\n","\n","            # Remover quaisquer colunas 'Unnamed' que possam aparecer de colunas vazias no Excel\n","            df_temp = current_sheet_raw_df.drop(columns=[col for col in current_sheet_raw_df.columns if col.startswith('Unnamed:')], errors='ignore')\n","\n","            # Remover a primeira linha de dados (índice 0) se estiver quase vazia, conforme sugerido pela saída anterior de df.head().\n","            # Isso lida com linhas potencialmente vazias logo após o cabeçalho.\n","            # Verificamos se as duas primeiras colunas de canonical_columns são NaN na primeira linha de dados.\n","            if not df_temp.empty and canonical_columns:\n","                # Verificar NaNs na primeira linha nas colunas canônicas relevantes\n","                first_row_check_cols = [col for col in canonical_columns if col in df_temp.columns and df_temp[col].isnull().iloc[0]]\n","                # Se a maioria da primeira linha de dados reais for NaN, é provável que seja uma linha separadora vazia\n","                if len(first_row_check_cols) > (len(canonical_columns) / 2): # Heurística: se mais da metade for NaN\n","                    df_temp = df_temp.iloc[1:].reset_index(drop=True)\n","\n","            # Garantir que df_temp tenha as colunas canônicas, reordenar e preencher as que faltam com NaN\n","            if canonical_columns:\n","                # Adicionar colunas canônicas ausentes ao df_temp, preenchidas com NaN\n","                for col in canonical_columns:\n","                    if col not in df_temp.columns:\n","                        df_temp[col] = np.nan\n","                # Reordenar colunas para corresponder à ordem canônica\n","                df_temp = df_temp[canonical_columns]\n","\n","            df_temp['ANO'] = year # Adicionar coluna 'ANO' para cada DataFrame\n","            dfs_from_sheets.append(df_temp)\n","        else:\n","            print(f\"Aviso: Aba '{sheet_name}' não encontrada na planilha.\")\n","\n","    if dfs_from_sheets:\n","        df = pd.concat(dfs_from_sheets, ignore_index=True)\n","        # Limpar linhas totalmente vazias que podem vir da exportação\n","        df.dropna(how='all', inplace=True)\n","        print(\"Dados carregados com sucesso de todas as abas especificadas.\")\n","        display(df.head()) # Exibir o cabeçalho para confirmar a nova estrutura da coluna\n","    else:\n","        print(\"Nenhum dado foi carregado das abas especificadas.\")\n","        df = pd.DataFrame() # Cria um DataFrame vazio se nada foi carregado\n","\n","except Exception as e:\n","    print(f\"Erro ao ler as planilhas do Google Sheet: {e}\")\n","    df = pd.DataFrame() # Cria um DataFrame vazio em caso de erro"]},{"cell_type":"markdown","metadata":{"id":"50968443"},"source":["## Visualização da Extração dos Dados\n","A célula `df.info()` é essencial para obter um resumo conciso do DataFrame. Ela exibe informações como o número total de entradas, o número de colunas, o tipo de dados (Dtype) de cada coluna, a quantidade de valores não nulos por coluna e o uso de memória. Essa visualização é crucial para entender a estrutura dos dados, identificar colunas com valores ausentes e verificar se os tipos de dados estão corretos para as análises subsequentes."]},{"cell_type":"code","source":["print(\"=\"*75 + \"\\n Informações ger